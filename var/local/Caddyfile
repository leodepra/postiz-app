{
  admin off
  auto_https disable_redirects
}
https://localhost:7443 {
  tls internal
  header -Server
  header Referrer-Policy no-referrer
  header X-Content-Type-Options nosniff
  request_body {
    max_size 2GB
  }
  @file path_regexp file ^/uploads/([0-9]{4}/[0-9]{2}/[0-9]{2}/[a-f0-9]+\.[a-z0-9]+)$
  handle @file {
    rewrite * /media/local-file?file={re.file.1}
    reverse_proxy 172.30.251.10:3000 {
      header_up -X-Local-Internal
      header_up -Auth
      header_up -Impersonate
    }
  }
  handle /uploads/* {
    respond 404
  }
  handle /api/uploads/* {
    respond 404
  }
  handle_path /api/* {
    reverse_proxy 172.30.251.10:3000 {
      header_up -X-Local-Internal
      header_up -Auth
      header_up -Impersonate
    }
  }
  handle {
    reverse_proxy 172.30.251.10:4200 {
      header_up -X-Local-Internal
      header_up -Auth
      header_up -Impersonate
    }
  }
}
